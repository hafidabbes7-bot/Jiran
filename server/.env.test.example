# Adresse de la base PostgreSQL utilisée par `npm test`.
# Copiez ce fichier en `.env.test` (non commité) et adaptez l'adresse.
# Cette base est effacée et recréée par les tests : n'y mettez jamais
# l'adresse d'une base qui contient de vraies données.
TEST_DATABASE_URL=postgresql://jiran@localhost:5432/jiran_test
