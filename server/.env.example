# --- Obligatoire ---
# Deux clés distinctes, 32 caractères minimum. En production, le serveur refuse
# de démarrer sans elles plutôt que d'en inventer une silencieusement.
# Pour en générer une : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=
SESSION_SECRET=

PORT=4000
# NODE_ENV=production

# --- Canal SMS ---
# console : rien n'est envoyé, le code s'affiche dans la console (développement)
# http    : passerelle d'un agrégateur local algérien (recommandé en production)
# twilio  : Twilio
# none    : ferme le canal SMS, pour ne proposer que WhatsApp
#
# Le canal WhatsApp, lui, s'ouvre dès que les identifiants Meta plus bas sont
# renseignés. En développement avec « console », les deux canaux sont ouverts,
# pour pouvoir tester le choix à l'inscription sans compte WhatsApp Business.
SMS_PROVIDER=console

# Nom affiché comme expéditeur. 11 caractères maximum, et il doit être
# approuvé au préalable auprès des opérateurs via l'agrégateur.
SMS_SENDER_ID=Jiran

# --- Passerelle HTTP générique (SMS_PROVIDER=http) ---
# Les noms de champs varient d'un agrégateur à l'autre : ajustez-les plutôt que
# de modifier le code.
SMS_HTTP_URL=
SMS_HTTP_API_KEY=
SMS_HTTP_PHONE_FIELD=to
SMS_HTTP_MESSAGE_FIELD=message
SMS_HTTP_SENDER_FIELD=sender

# --- Twilio (SMS_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Canal WhatsApp gratuit (le voisin nous envoie le message) ---
# Rien n'est envoyé par le serveur, donc rien n'est facturé. Il faut :
#   1. un numéro WhatsApp Business, au format international sans « + » ;
#   2. le secret de l'application Meta, qui signe les webhooks entrants ;
#   3. un jeton de votre choix, que Meta renvoie pour valider l'URL du webhook.
# L'URL à déclarer chez Meta est https://votre-domaine/webhooks/whatsapp
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- Canal WhatsApp payant (le serveur envoie un code) ---
# Exige un compte WhatsApp Business vérifié et un modèle de catégorie
# « authentification » approuvé par Meta.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=jiran_verification
WHATSAPP_TEMPLATE_LANGUAGE=fr

# Développement : ouvre ce canal sans compte Meta, pour voir le choix à
# l'inscription. Sans lui, seul le SMS est proposé — le parcours habituel.
WHATSAPP_DEV_CONSOLE=false

# --- Réglages du code (valeurs par défaut raisonnables) ---
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_WINDOW=5
OTP_WINDOW_SECONDS=3600
SESSION_TTL_DAYS=90

# --- Développement uniquement ---
# Renvoie le code dans la réponse HTTP, pour tester sans lire la console.
# Ignoré si NODE_ENV=production.
EXPOSE_DEV_CODE=false

# Origines autorisées depuis un navigateur (expo start --web).
# Vide en production = aucun appel navigateur accepté.
CORS_ORIGINS=*
