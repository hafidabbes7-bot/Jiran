# --- Obligatoire ---
# Deux clés distinctes, 32 caractères minimum. En production, le serveur refuse
# de démarrer sans elles plutôt que d'en inventer une silencieusement.
# Pour en générer une : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=
SESSION_SECRET=

PORT=4000
# NODE_ENV=production

# --- Canal SMS ---
# console : rien n'est envoyé, le code s'affiche dans la console (développement)
# http    : passerelle d'un agrégateur local algérien (recommandé en production)
# twilio  : Twilio
# none    : ferme le canal SMS, pour ne proposer que WhatsApp
#
# Le canal WhatsApp, lui, s'ouvre dès que les identifiants Meta plus bas sont
# renseignés. En développement avec « console », les deux canaux sont ouverts,
# pour pouvoir tester le choix à l'inscription sans compte WhatsApp Business.
SMS_PROVIDER=console

# Nom affiché comme expéditeur. 11 caractères maximum, et il doit être
# approuvé au préalable auprès des opérateurs via l'agrégateur.
SMS_SENDER_ID=Jiran

# --- Passerelle HTTP générique (SMS_PROVIDER=http) ---
# Les noms de champs varient d'un agrégateur à l'autre : ajustez-les plutôt que
# de modifier le code.
SMS_HTTP_URL=
SMS_HTTP_API_KEY=
SMS_HTTP_PHONE_FIELD=to
SMS_HTTP_MESSAGE_FIELD=message
SMS_HTTP_SENDER_FIELD=sender

# --- Twilio (SMS_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Canal e-mail (le seul gratuit à l'envoi) ---
# smtp    : une boîte existante (Gmail, Outlook) + un mot de passe d'application
# resend  : offre gratuite de 3 000 messages par mois, sans carte bancaire
# console : n'envoie rien, le code s'affiche — développement seulement
# none    : ferme le canal
# Voir docs/verification-reelle.md pour les deux marches à suivre.
EMAIL_PROVIDER=none
EMAIL_FROM=
EMAIL_SUBJECT=Votre code Jiran
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
RESEND_API_KEY=

# --- Canal WhatsApp gratuit (le voisin nous envoie le message) ---
# Rien n'est envoyé par le serveur, donc rien n'est facturé. Il faut :
#   1. un numéro WhatsApp Business, au format international sans « + » ;
#   2. le secret de l'application Meta, qui signe les webhooks entrants ;
#   3. un jeton de votre choix, que Meta renvoie pour valider l'URL du webhook.
# L'URL à déclarer chez Meta est https://votre-domaine/webhooks/whatsapp
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- Canal WhatsApp payant (le serveur envoie un code) ---
# Exige un compte WhatsApp Business vérifié et un modèle de catégorie
# « authentification » approuvé par Meta.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=jiran_verification
WHATSAPP_TEMPLATE_LANGUAGE=fr

# Développement : ouvre ce canal sans compte Meta, pour voir le choix à
# l'inscription. Sans lui, seul le SMS est proposé — le parcours habituel.
WHATSAPP_DEV_CONSOLE=false

# --- Modération ---
# Numéros des modérateurs, séparés par des virgules. Ce sont les seuls à voir
# la file des signalements et à pouvoir bloquer ou rétablir un contenu.
# Le format n'a pas d'importance : 0555…, +213555… ou 00213555… se valent.
MODERATOR_PHONES=

# --- Notifications (alertes sécurité et SOS) ---
# expo    : remet réellement, via le service de notifications d'Expo
# console : affiche seulement — l'application prévient alors qu'aucun téléphone
#           ne sonnera. Refusé en production.
PUSH_PROVIDER=console
# Requis si votre projet Expo impose l'authentification pour l'envoi.
EXPO_ACCESS_TOKEN=

# --- Base de données (obligatoire) ---
# Adresse PostgreSQL complète. En ligne, c'est l'URI de connexion Supabase
# (Project Settings → Database → Connection string → URI). Elle contient le mot
# de passe de la base : ne la copiez jamais dans un fichier du dépôt, seulement
# dans l'onglet Environment de l'hébergeur.
# Le schéma se pose avec « npm run migrate », jamais au démarrage du serveur.
DATABASE_URL=

# --- Stockage des photos (Supabase Storage) ---
# Sans ces valeurs, les photos sont rangées dans la base elle-même : cela
# fonctionne, mais remplit vite les 500 Mo gratuits.
# SUPABASE_SERVICE_KEY est la clé « service_role » : elle donne tous les droits
# sur le stockage et ne doit jamais quitter le serveur.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=jiran-photos

# Ménage quotidien des publications arrivées à terme (10 à 45 jours selon
# l'intérêt suscité). « false » le coupe. Voir docs/base-de-donnees.md.
CLEANUP_ENABLED=true

# --- Réglages du code (valeurs par défaut raisonnables) ---
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_WINDOW=5
OTP_WINDOW_SECONDS=3600
SESSION_TTL_DAYS=90

# --- Développement uniquement ---
# Renvoie le code dans la réponse HTTP, pour tester sans lire la console.
# Ignoré si NODE_ENV=production.
EXPOSE_DEV_CODE=false

# Origines autorisées depuis un navigateur (expo start --web).
# Vide en production = aucun appel navigateur accepté.
CORS_ORIGINS=*
