{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "apk-local": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_ALLOW_CLEARTEXT": "true",
        "EXPO_PUBLIC_API_URL": "http://192.168.1.10:4000"
      }
    },
    "apk": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.exemple.dz"
      }
    },
    "production": {
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.exemple.dz"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
